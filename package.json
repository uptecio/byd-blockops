{
  "name": "block-ops-offline",
  "version": "0.9.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "server": "node server/server.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser.mjs",
    "test:home": "node tests/home.browser.mjs",
    "test:touch": "node tests/input.browser.mjs",
    "test:multiplayer": "node tests/multiplayer.browser.mjs",
    "test:configurations": "node tests/configurations.browser.mjs",
    "test:loot": "node tests/loot.browser.mjs",
    "test:loot:touch": "node tests/loot-touch.browser.mjs",
    "test:webview": "node tests/webview-startup.browser.mjs && node tests/webview-layout.browser.mjs && node tests/runtime-errors.browser.mjs",
    "test:inventory": "node tests/inventory.browser.mjs",
    "test:zombies": "node tests/zombies.browser.mjs && node tests/zombies-layout.browser.mjs",
    "test:supplies": "node tests/supplies.browser.mjs && node tests/supplies-layout.browser.mjs",
    "test:progression": "node tests/progression.browser.mjs && node tests/progression-layout.browser.mjs",
    "test:progression:modes": "node tests/progression-modes.browser.mjs",
    "test:progression:online": "node tests/progression-online.browser.mjs",
    "test:solo-powers": "node tests/solo-powers.browser.mjs && node tests/solo-powers-layout.browser.mjs && node tests/solo-powers-online.browser.mjs",
    "test:shooting-range": "node tests/shooting-range.browser.mjs && node tests/shooting-range-layout.browser.mjs && node tests/shooting-range-online.browser.mjs",
    "test:rooftops": "node tests/rooftops.browser.mjs",
    "test:tall-roofs": "node tests/tall-roofs.browser.mjs",
    "test:tall-roofs:online": "node tests/tall-roofs-online.browser.mjs",
    "test:traversal:performance": "node tests/traversal-performance.mjs",
    "test:hiding:online": "node tests/hiding-online.browser.mjs",
    "test:hiding:layout": "node tests/hiding-layout.browser.mjs",
    "test:rooftops:android": "node android/tests/rooftops-smoke.mjs",
    "test:rooftops:android:online": "node android/tests/rooftops-online-smoke.mjs",
    "test:progression:android": "node android/tests/progression-smoke.mjs",
    "test:progression:android:online": "node android/tests/progression-online-smoke.mjs",
    "apk": "npm run build && bash scripts/build-apk.sh",
    "test:apk": "node android/tests/package-smoke.mjs"
  },
  "dependencies": {
    "three": "0.160.1",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "playwright": "1.58.2"
  }
}
